{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mango-latest-posts/blog-grid",
	"version": "1.0.0",
	"title": "Mango Blog Grid",
	"category": "widgets",
	"icon": "grid-view",
	"description": "Show your latest blog posts in a card grid or masonry layout.",
	"keywords": [ "latest posts", "blog", "recent posts", "grid", "masonry" ],
	"textdomain": "mango-latest-posts",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"posts": { "type": "number", "default": 3 },
		"columns": { "type": "number", "default": 3 },
		"layout": { "type": "string", "enum": [ "grid", "masonry" ], "default": "grid" },
		"excerptWords": { "type": "number", "default": 30 },
		"categories": { "type": "array", "items": { "type": "number" }, "default": [] },
		"offset": { "type": "number", "default": 0 },
		"excludeCurrent": { "type": "boolean", "default": true },
		"readMoreText": { "type": "string", "default": "" },
		"titleTag": { "type": "string", "default": "h3" },
		"titleColor": { "type": "string", "default": "" },
		"titleFontSize": { "type": "number" },
		"excerptColor": { "type": "string", "default": "" },
		"excerptFontSize": { "type": "number" },
		"buttonBg": { "type": "string", "default": "" },
		"buttonColor": { "type": "string", "default": "" },
		"buttonFontSize": { "type": "number" },
		"buttonPaddingY": { "type": "number" },
		"buttonPaddingX": { "type": "number" },
		"cardBg": { "type": "string", "default": "" },
		"borderColor": { "type": "string", "default": "" },
		"borderWidth": { "type": "number" },
		"borderRadius": { "type": "number" },
		"cardPadding": { "type": "number" },
		"gap": { "type": "number" }
	},
	"editorScript": "file:./index.js",
	"style": "mango-lp-style"
}
